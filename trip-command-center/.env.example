# Copy to .env.local for local development; set the same values in Vercel.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (extraction uses claude-sonnet-5-5; country briefs and the planner use claude-opus-5-5)
ANTHROPIC_API_KEY=

# Resend inbound email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=whsec_...
# Secret, unguessable address used only in your forwarding rules. Mail that
# Resend did not deliver to exactly this address is rejected, so make the
# local part random, e.g. atlas-k3f9q2xw7m@inbound.your-domain.com.
INBOUND_ADDRESS=atlas-change-me@inbound.your-domain.com
# Addresses whose forwarding rules may feed the app, comma separated
ALLOWED_FORWARDERS=you@personal.example,you@work.example
# The single account that owns ingested mail (must sign in once first)
OWNER_EMAIL=you@personal.example

# Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The database scheduler (supabase/migrations/0007) sends this as a bearer
# token; store the same value in Vault as atlas_cron_secret.
CRON_SECRET=

# Home base
HOME_AIRPORTS=SRQ,TPA
USER_TIMEZONE=America/New_York
# Fixed drive estimates to each home airport, minutes (defaults SRQ 30, TPA 75)
# DRIVE_MINUTES_SRQ=30
# DRIVE_MINUTES_TPA=75
# Passports held, for embassies and entry rules in country briefs
CITIZENSHIPS=US,FR

# Optional
# GSA per diem (free key from https://api.data.gov/signup/)
GSA_API_KEY=
# Live flight position and inbound aircraft (FlightAware AeroAPI, billed per query)
FLIGHTAWARE_API_KEY=
